diff --git a/runtime/rt/cudnn.cpp b/runtime/rt/cudnn.cpp
index f5658e8..68290f8 100644
--- a/runtime/rt/cudnn.cpp
+++ b/runtime/rt/cudnn.cpp
@@ -1,0 +2,2 @@
+#include "cudnn_softmax_msl.h"
+#include "library_kernel_source.h"
@@ -17,2 +18,0 @@
-@UPSTREAM_LINE=17@
-@UPSTREAM_LINE=18@
@@ -261,0 +262,113 @@ bool filter_pointer_valid(const void* pointer, const cudnnFilterStruct* filter)
+struct SoftmaxParams {
+    std::uint32_t columns;
+    std::uint32_t spatial;
+    std::uint32_t channel_mode;
+    std::uint32_t logarithmic;
+    float alpha;
+    float beta;
+};
+static_assert(sizeof(SoftmaxParams) == 24);
+
+cudnnStatus_t softmax_metal(cudnnHandle_t handle, const cudnnTensorStruct& desc,
+                            cudnnSoftmaxMode_t mode, cudnnSoftmaxAlgorithm_t algo,
+                            const void* alpha, const void* x, const void* beta, void* y,
+                            std::size_t bytes) {
+    using cumetal::rt::AllocationTable;
+    using cumetal::metal_backend::KernelArg;
+    AllocationTable::ResolvedAllocation rx, ry, ra, rb;
+    const bool x_tracked = cumetal::rt::resolve_allocation_for_pointer(x, &rx);
+    const bool y_tracked = cumetal::rt::resolve_allocation_for_pointer(y, &ry);
+    const bool a_tracked = cumetal::rt::resolve_allocation_for_pointer(alpha, &ra);
+    const bool b_tracked = cumetal::rt::resolve_allocation_for_pointer(beta, &rb);
+    if ((a_tracked && !ra.buffer) || (b_tracked && !rb.buffer))
+        return CUDNN_STATUS_BAD_PARAM;
+    if (reinterpret_cast<std::uintptr_t>(x) % alignof(float) != 0 ||
+        reinterpret_cast<std::uintptr_t>(y) % alignof(float) != 0) {
+        return CUDNN_STATUS_BAD_PARAM;
+    }
+    const auto overlaps = [bytes](std::uintptr_t a, std::uintptr_t b) {
+        return a < b ? b - a < bytes : a - b < bytes;
+    };
+    if (x_tracked && y_tracked && rx.buffer == ry.buffer) {
+        if (rx.offset != ry.offset && overlaps(rx.offset, ry.offset))
+            return CUDNN_STATUS_BAD_PARAM;
+    } else if (x != y && overlaps(reinterpret_cast<std::uintptr_t>(x),
+                                 reinterpret_cast<std::uintptr_t>(y))) {
+        return CUDNN_STATUS_BAD_PARAM;
+    }
+
+    cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(handle->stream, &capture_status) != cudaSuccess)
+        return CUDNN_STATUS_EXECUTION_FAILED;
+    if (capture_status != cudaStreamCaptureStatusNone) return CUDNN_STATUS_NOT_SUPPORTED;
+
+    std::shared_ptr<cumetal::metal_backend::Stream> stream;
+    if (cumetal::rt::resolve_backend_stream(handle->stream, &stream) != cudaSuccess)
+        return CUDNN_STATUS_EXECUTION_FAILED;
+
+    std::vector<KernelArg> args(3);
+    if ((x_tracked && !cumetal::rt::resolve_kernel_buffer_arg(x, bytes, alignof(float), &args[0])) ||
+        (y_tracked && !cumetal::rt::resolve_kernel_buffer_arg(y, bytes, alignof(float), &args[1]))) {
+        return CUDNN_STATUS_BAD_PARAM;
+    }
+    const bool staged = !x_tracked || !y_tracked;
+    if (staged || a_tracked || b_tracked) {
+        const auto status = sync_handle(handle);
+        if (status != CUDNN_STATUS_SUCCESS) return status;
+    }
+    const auto scalar = [](const void* p, bool tracked,
+                           const AllocationTable::ResolvedAllocation& r) {
+        const void* host = tracked
+            ? static_cast<const unsigned char*>(r.buffer->contents()) + r.offset : p;
+        float value;
+        std::memcpy(&value, host, sizeof(value));
+        return value;
+    };
+    const float a = scalar(alpha, a_tracked, ra);
+    const float b = scalar(beta, b_tracked, rb);
+    std::string error;
+    for (std::size_t i = 0; i < 2; ++i) {
+        if ((i == 0 && x_tracked) || (i == 1 && y_tracked)) continue;
+        args[i].kind = KernelArg::Kind::kBuffer;
+        const cudaError_t status = cumetal::metal_backend::allocate_buffer(bytes, &args[i].buffer, &error);
+        if (status != cudaSuccess)
+            return status == cudaErrorMemoryAllocation ? CUDNN_STATUS_ALLOC_FAILED
+                                                       : CUDNN_STATUS_EXECUTION_FAILED;
+        if (i == 0 || b != 0.0f) {
+            std::memcpy(args[i].buffer->contents(), i == 0 ? x : y, bytes);
+        }
+    }
+
+    const std::uint32_t spatial = static_cast<std::uint32_t>(desc.h * desc.w);
+    const std::uint32_t columns = mode == CUDNN_SOFTMAX_MODE_CHANNEL
+        ? static_cast<std::uint32_t>(desc.c) : static_cast<std::uint32_t>(desc.c) * spatial;
+    const SoftmaxParams params{columns, spatial,
+        static_cast<std::uint32_t>(mode == CUDNN_SOFTMAX_MODE_CHANNEL),
+        static_cast<std::uint32_t>(algo == CUDNN_SOFTMAX_LOG), a, b};
+    args[2].kind = KernelArg::Kind::kBytes;
+    args[2].bytes.resize(sizeof(params));
+    std::memcpy(args[2].bytes.data(), &params, sizeof(params));
+
+    const auto* source = cumetal::rt::stage_library_kernel_source(
+        "cudnn_softmax_f32", cumetal::rt::kCudnnSoftmaxMsl);
+    if (!source) return CUDNN_STATUS_EXECUTION_FAILED;
+    unsigned threads = 32;
+    while (threads < columns && threads < 256) threads *= 2;
+    cumetal::metal_backend::LaunchConfig config{};
+    config.block = dim3(threads, 1, 1);
+    config.grid = dim3(static_cast<unsigned>(bytes / sizeof(float) / columns), 1, 1);
+    config.provenance = "library_substitution";
+    config.semantic_quality = "tolerance_bounded";
+    if (cumetal::metal_backend::launch_kernel(*source, "cumetal_cudnn_softmax_f32",
+                                             config, args, stream, &error) != cudaSuccess) {
+        CUDNN_DEBUG("softmax Metal launch failed: %s", error.c_str());
+        return CUDNN_STATUS_EXECUTION_FAILED;
+    }
+    if (staged) {
+        if (cumetal::metal_backend::stream_synchronize(stream, &error) != cudaSuccess)
+            return CUDNN_STATUS_EXECUTION_FAILED;
+        if (!y_tracked) std::memcpy(y, args[1].buffer->contents(), bytes);
+    }
+    return CUDNN_STATUS_SUCCESS;
+}
+
@@ -1341,0 +1455,3 @@ cudnnStatus_t cudnnSoftmaxForward(cudnnHandle_t handle,
+    int count = 0, y_count = 0;
+    if (!tensor_count_int(xDesc, &count) || !tensor_count_int(yDesc, &y_count))
+        return CUDNN_STATUS_BAD_PARAM;
@@ -1354,52 +1470,2 @@ cudnnStatus_t cudnnSoftmaxForward(cudnnHandle_t handle,
-    cudnnStatus_t sync_status = sync_handle(handle);
-    if (sync_status != CUDNN_STATUS_SUCCESS) return sync_status;
-    float a = *static_cast<const float*>(alpha);
-    float b = *static_cast<const float*>(beta);
-    const float* xf = static_cast<const float*>(x);
-    float* yf = static_cast<float*>(y);
-
-    int N = xDesc->n, C = xDesc->c, H = xDesc->h, W = xDesc->w;
-
-    if (mode == CUDNN_SOFTMAX_MODE_INSTANCE) {
-        int spatial = C * H * W;
-        for (int n = 0; n < N; ++n) {
-            const float* src = xf + n * spatial;
-            float* dst = yf + n * spatial;
-            float maxval = *std::max_element(src, src + spatial);
-            float sum = 0.0f;
-            for (int i = 0; i < spatial; ++i) sum += std::exp(src[i] - maxval);
-            if (algo == CUDNN_SOFTMAX_LOG) {
-                float logsum = std::log(sum);
-                for (int i = 0; i < spatial; ++i)
-                    dst[i] = a * (src[i] - maxval - logsum) + b * dst[i];
-            } else {
-                for (int i = 0; i < spatial; ++i)
-                    dst[i] = a * (std::exp(src[i] - maxval) / sum) + b * dst[i];
-            }
-        }
-@UPSTREAM_LINE=1380@
-        for (int n = 0; n < N; ++n) {
-            for (int h = 0; h < H; ++h) {
-                for (int w = 0; w < W; ++w) {
-                    float maxval = -1e30f;
-                    for (int c = 0; c < C; ++c) {
-                        int idx = ((n * C + c) * H + h) * W + w;
-                        maxval = std::max(maxval, xf[idx]);
-                    }
-                    float sum = 0.0f;
-                    for (int c = 0; c < C; ++c) {
-                        int idx = ((n * C + c) * H + h) * W + w;
-                        sum += std::exp(xf[idx] - maxval);
-                    }
-                    for (int c = 0; c < C; ++c) {
-                        int idx = ((n * C + c) * H + h) * W + w;
-                        if (algo == CUDNN_SOFTMAX_LOG)
-                            yf[idx] = a * (xf[idx] - maxval - std::log(sum)) + b * yf[idx];
-                        else
-                            yf[idx] = a * (std::exp(xf[idx] - maxval) / sum) + b * yf[idx];
-                    }
-                }
-            }
-        }
-    }
-    return CUDNN_STATUS_SUCCESS;
+    return softmax_metal(handle, *xDesc, mode, algo, alpha, x, beta, y,
+                         static_cast<std::size_t>(count) * sizeof(float));
diff --git a/runtime/rt/cudnn_softmax_msl.h b/runtime/rt/cudnn_softmax_msl.h
new file mode 100644
index 0000000..a10bf7d
--- /dev/null
+++ b/runtime/rt/cudnn_softmax_msl.h
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <string_view>
+
+namespace cumetal::rt {
+
+inline constexpr std::string_view kCudnnSoftmaxMsl = R"MSL(
+struct CudnnSoftmaxParams {
+    uint columns;
+    uint spatial;
+    uint channel_mode;
+    uint logarithmic;
+    float alpha;
+    float beta;
+};
+
+kernel void cumetal_cudnn_softmax_f32(
+    const device float* x [[buffer(0)]],
+    device float* y [[buffer(1)]],
+    constant CudnnSoftmaxParams& p [[buffer(2)]],
+    uint3 group [[threadgroup_position_in_grid]],
+    uint tid [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]],
+    uint warp [[simdgroup_index_in_threadgroup]],
+    uint3 threads [[threads_per_threadgroup]]) {
+    const uint stride = p.channel_mode ? p.spatial : 1;
+    const ulong base = p.channel_mode
+        ? ulong(group.x / p.spatial) * p.columns * p.spatial + group.x % p.spatial
+        : ulong(group.x) * p.columns;
+    const uint warps = threads.x / 32;
+    threadgroup float partials[8];
+
+    float maximum = -INFINITY;
+    for (uint i = tid; i < p.columns; i += threads.x) {
+        maximum = max(maximum, x[base + ulong(i) * stride]);
+    }
+    maximum = simd_max(maximum);
+    if (lane == 0) partials[warp] = maximum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (warp == 0) {
+        const float candidate = lane < warps ? partials[lane] : -INFINITY;
+        const float reduced = simd_max(candidate);
+        if (lane == 0) partials[0] = reduced;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    maximum = partials[0];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    float sum = 0.0f;
+    for (uint i = tid; i < p.columns; i += threads.x) {
+        sum += exp(x[base + ulong(i) * stride] - maximum);
+    }
+    sum = simd_sum(sum);
+    if (lane == 0) partials[warp] = sum;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (warp == 0) {
+        const float candidate = lane < warps ? partials[lane] : 0.0f;
+        const float reduced = simd_sum(candidate);
+        if (lane == 0) partials[0] = reduced;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup | mem_flags::mem_device);
+    sum = partials[0];
+    const float normalizer = p.logarithmic ? log(sum) : 1.0f / sum;
+
+    for (uint i = tid; i < p.columns; i += threads.x) {
+        const ulong index = base + ulong(i) * stride;
+        const float shifted = x[index] - maximum;
+        const float value = p.logarithmic ? shifted - normalizer
+                                          : exp(shifted) * normalizer;
+        if (p.beta == 0.0f) y[index] = p.alpha * value;
+        else y[index] = p.alpha * value + p.beta * y[index];
+    }
+}
+)MSL";
+
+}
diff --git a/tools/cumetal/main.cpp b/tools/cumetal/main.cpp
index 3f7b8d3..f1424cd 100644
--- a/tools/cumetal/main.cpp
+++ b/tools/cumetal/main.cpp
@@ -103 +103 @@ void print_usage(const char *argv0) {
-            << "  " << name << " run <program> [args...]\n"
+            << "  " << name << " run [--ptx] [--] <program> [args...]\n"
@@ -104,0 +105,5 @@ void print_usage(const char *argv0) {
+            << "Run options:\n"
+            << "  --ptx  Use the supported PTX runtime compiler path.\n"
+            << "         Defaults to software IEEE64; disables workload substitutions\n"
+            << "         and llm.c CPU emulation. Library calls may have separate CPU paths.\n"
+            << "  --     Treat the next argument as the program name.\n\n"
@@ -274 +279,9 @@ int run_program(int argc, char **argv) {
-  if (argc < 3) {
+  int program_index = 2;
+  const bool ptx = argc > program_index &&
+                   std::string_view(argv[program_index]) == "--ptx";
+  if (ptx)
+    ++program_index;
+  if (argc > program_index &&
+      std::string_view(argv[program_index]) == "--")
+    ++program_index;
+  if (argc <= program_index) {
@@ -295 +308,28 @@ int run_program(int argc, char **argv) {
-  execvp(argv[2], &argv[2]);
+  if (ptx) {
+    setenv("CUMETAL_DRIVER_JIT", "runtime-msl", 1);
+    setenv("CUMETAL_PTX_BACKEND", "cumetal-ir", 1);
+    setenv("CUMETAL_ENABLE_WORKLOAD_SPECIALIZATIONS", "0", 1);
+    setenv("CUMETAL_ENABLE_LLMC_CPU_EMULATION", "0", 1);
+    setenv("CUMETAL_DISABLE_LLMC_EMULATION", "1", 1);
+    if (const char *compiler = std::getenv("CUMETAL_NVRTC_COMPILER");
+        compiler == nullptr || compiler[0] == '\0') {
+      const std::string compiler_path = (layout.bin_dir / "cumetalc").string();
+      setenv("CUMETAL_NVRTC_COMPILER", compiler_path.c_str(), 1);
+    }
+    if (const char *precision = std::getenv("CUMETAL_FP64_MODE");
+        precision == nullptr || precision[0] == '\0') {
+      setenv("CUMETAL_FP64_MODE", "ieee64", 1);
+    }
+    if (const char *sdk = std::getenv("SDKROOT");
+        sdk == nullptr || sdk[0] == '\0') {
+      const CommandResult found = run_capture(
+          "/usr/bin/xcrun --sdk macosx --show-sdk-path 2>/dev/null");
+      std::error_code error;
+      if (found.exit_code == 0 && !found.output.empty() &&
+          std::filesystem::is_directory(found.output, error)) {
+        setenv("SDKROOT", found.output.c_str(), 1);
+      }
+    }
+  }
+
+  execvp(argv[program_index], &argv[program_index]);
