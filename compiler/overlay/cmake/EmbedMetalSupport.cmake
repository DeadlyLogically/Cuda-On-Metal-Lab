function(cumetal_expand_metal_support input output)
    set(active "${ARGN}")
    if(NOT EXISTS "${input}")
        message(FATAL_ERROR "Missing bundled Metal support: ${input}")
    endif()
    get_filename_component(source "${input}" REALPATH)
    if(source IN_LIST active)
        message(FATAL_ERROR "Cyclic bundled Metal include: ${source}")
    endif()
    list(LENGTH active depth)
    if(depth GREATER 32)
        message(FATAL_ERROR "Bundled Metal include depth exceeded")
    endif()
    list(APPEND active "${source}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    file(READ "${source}" text)
    get_filename_component(parent "${source}" DIRECTORY)
    string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]+\"[^\"\n]+\"[^\n]*" includes "${text}")
    foreach(directive IN LISTS includes)
        string(REGEX MATCH "\"([^\"]+)\"" ignored "${directive}")
        set(child "${CMAKE_MATCH_1}")
        if(NOT IS_ABSOLUTE "${child}")
            set(child "${parent}/${child}")
        endif()
        cumetal_expand_metal_support("${child}" expanded "${active}")
        string(REPLACE "${directive}" "\n${expanded}\n" text "${text}")
    endforeach()

    if(text MATCHES "(^|\n)[ \t]*#[ \t]*include[ \t]+[^< \t]")
        message(FATAL_ERROR "Unsupported bundled Metal include in ${source}")
    endif()
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
